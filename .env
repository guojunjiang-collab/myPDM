# ============================================================
# myPDM 配置模板
# 复制此文件为 .env 并填写实际值
#   cp .env.example .env
# ============================================================

# Nginx 宿主机映射端口（默认 8080）
NGINX_HOST_PORT=8080

# PostgreSQL 数据库数据目录（宿主机路径）
PGDATA_HOST_PATH=../myPDM_data/pgdata

# 附件上传文件存储目录（宿主机路径）
UPLOADS_HOST_PATH=../myPDM_data/uploads

# ============================================================
# 安全密钥（必填 - 按操作系统选择命令生成）
# ============================================================
# JWT_SECRET (64字符):
#   Linux/Mac:   openssl rand -hex 32
#   Windows PS:  -join ((48..57)+(65..90)+(97..122)|Get-Random -Count 64|%{[char]$_})
#   Docker:      docker run --rm alpine openssl rand -hex 32
#
# REDIS_PASSWORD / POSTGRES_PASSWORD (32字符):
#   Linux/Mac:   openssl rand -base64 24
#   Windows PS:  -join ((48..57)+(65..90)+(97..122)|Get-Random -Count 32|%{[char]$_})
#   Docker:      docker run --rm alpine openssl rand -base64 24
# ============================================================
JWT_SECRET=E7F740775FB415031A1EC3B12193D90B7C25DED826AFAB53CFEC14CAA81EDC6B
REDIS_PASSWORD=6rSoMRQ2U48CxLGmdEpg5AKH90stVFYO
POSTGRES_PASSWORD=0s2oD7tcML6iukj3KFyanEqzAvO9PQTg

# ============================================================
# AI 助手配置（DeepSeek）
# ============================================================
# 申请地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ASSISTANT_MAX_ITERS=8
ASSISTANT_BOM_RAW_THRESHOLD=200
ASSISTANT_API_MAX_CHARS=8000
ASSISTANT_API_TIMEOUT=15
