# ============================================================
# myPDM 数据存储路径配置
# ============================================================
# 修改后执行 docker-compose up -d 重建容器生效
# 注意: 旧数据不会自动迁移，需手动复制
# ============================================================

# PostgreSQL 数据库数据目录（宿主机路径）
PGDATA_HOST_PATH=./pgdata

# 附件上传文件存储目录（宿主机路径）
UPLOADS_HOST_PATH=./uploads
