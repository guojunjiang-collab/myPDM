# PDF 文件：零件类型前缀
CAD_PDF_PART_PREFIX=DR_

# PDF 文件：部件/装配类型前缀
CAD_PDF_ASSEMBLY_PREFIX=ASY_

# STP 文件前缀
CAD_STP_PREFIX=MD_
