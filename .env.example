# ============================================================
# myPDM 配置模板
# 复制此文件为 .env 并填写实际值：
#   cp .env.example .env
# 本模板与 .env 中的配置项保持一致，实际部署请参考 .env 填写。
# 注意：.env 已被 .gitignore 忽略，不会入库；本文件可入库作为模板。
# ============================================================

# Nginx 宿主机映射端口（默认 8080）
NGINX_HOST_PORT=8080

# PostgreSQL 数据库数据目录（宿主机路径）
PGDATA_HOST_PATH=../myPDM_data/pgdata

# 附件上传文件存储目录（宿主机路径）
UPLOADS_HOST_PATH=../myPDM_data/uploads

# ============================================================
# 安全密钥（必填 - 按操作系统选择命令生成）
# ============================================================
# JWT_SECRET (64字符):
#   Linux/Mac:   openssl rand -hex 32
#   Windows PS:  -join ((48..57)+(65..90)+(97..122)|Get-Random -Count 64|%{[char]$_})
#   Docker:      docker run --rm alpine openssl rand -hex 32
#
# REDIS_PASSWORD / POSTGRES_PASSWORD (32字符):
#   Linux/Mac:   openssl rand -base64 24
#   Windows PS:  -join ((48..57)+(65..90)+(97..122)|Get-Random -Count 32|%{[char]$_})
#   Docker:      docker run --rm alpine openssl rand -base64 24
# ============================================================
JWT_SECRET=change-me-to-a-random-64-char-hex-string
REDIS_PASSWORD=change-me-to-a-random-password
POSTGRES_PASSWORD=change-me-to-a-random-password
POSTGRES_USER=bomadmin
CORS_ORIGINS=https://localhost:8080
BACKEND_IMAGE=mypdm-backend:v3.2.3

# ============================================================
# AI 助手配置（DeepSeek）
# ============================================================
# 申请地址: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ASSISTANT_MAX_ITERS=8
ASSISTANT_BOM_RAW_THRESHOLD=200
ASSISTANT_API_MAX_CHARS=8000
ASSISTANT_API_TIMEOUT=15

# ============================================================
# 飞书免登（多企业 / 多路）
# ============================================================
# 飞书多企业接入：逗号分隔 provider key，未设置时默认仅主入口 feishu（单路）。
# 设置后自动启用多路，每个 key 对应一套 FEISHU_<KEY大写>_APP_ID / _APP_SECRET / _NAME（及可选 _REDIRECT_BASE）。
# provider key 请使用中性/业务命名，避免带入具体公司品牌。
FEISHU_PROVIDERS=feishu,companyB,companyC

# 主飞书应用（前缀 FEISHU_）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 第二路飞书应用（前缀 FEISHU_COMPANYB_，显示名可配）
FEISHU_COMPANYB_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_COMPANYB_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_COMPANYB_NAME=飞书登录（乙公司）

# 第三路飞书应用（前缀 FEISHU_COMPANYC_，显示名可配）
FEISHU_COMPANYC_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_COMPANYC_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_COMPANYC_NAME=飞书登录（丙公司）

# 回调基址：所有飞书 provider 的回调都会拼成 {FEISHU_REDIRECT_BASE}/api/auth/feishu/callback
FEISHU_REDIRECT_BASE=https://your-domain:8080

# ============================================================
# 微信开放平台网站应用（PC 扫码登录）
# ============================================================
# 需微信开放平台「网站应用」且通过企业认证；回调域配置为 {WEISHU_REDIRECT_BASE}/api/auth/wechat/callback
WECHAT_APP_ID=your-wechat-appid
WECHAT_APP_SECRET=your-wechat-appsecret
# 回调基础地址，需与开放平台「授权回调域」一致；默认复用 FEISHU_REDIRECT_BASE
WECHAT_REDIRECT_BASE=https://your-domain:8080
